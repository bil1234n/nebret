# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# PostgreSQL (or set a single DATABASE_URL=postgres://user:pass@host:5432/name instead)
DB_NAME=nebret
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
PUBLIC_BASE_URL=http://10.0.2.2:8000      # URL phones/WebViews use to reach this server (production: https://nebret.vercel.app)
APP_DEEP_LINK=nebret://payment-result
SUPPORT_EMAIL=support@nebret.et      # shown on /privacy/ and /account/delete/ – use an inbox you read

# --- Marketplace rules ---
RESERVATION_HOLD_MINUTES=30               # a unit is held this long while the customer pays
ORDER_PAYMENT_WINDOW_MINUTES=60
INSTALLMENT_GRACE_DAYS=5                  # days after the due date before an installment is late
INSTALLMENT_LATE_FEE_PERCENT=2            # late fee, % of the installment
MAX_INSTALLMENT_MONTHS=60
REFERRAL_BONUS_ENTRIES=5
COMPANY_PROFIT_PERCENT=5                  # dashboard profit = this % of revenue
DEFAULT_PAYMENT_PROVIDER=mock             # telebirr | chapa | mock
ENABLE_MOCK_GATEWAY=true                  # MUST be false in production

# --- telebirr (Ethio Telecom merchant credentials) ---
TELEBIRR_BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
TELEBIRR_WEB_CHECKOUT_URL=https://developerportal.ethiotelebirr.et:38443/payment/web/paygate?
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY_PEM=/run/secrets/telebirr_private.pem
TELEBIRR_PUBLIC_KEY_PEM=/run/secrets/telebirr_public.pem

# --- Chapa ---
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_CHECKOUT_TITLE=Nebret Equb

# --- Partner companies ---
AGENCY_COMMISSION_PERCENT=5               # Nebret Equb's commission on every company sale

# --- Push ---
PUSH_BACKEND=apps.notifications.push.LogPushBackend   # or apps.notifications.push.ExpoPushBackend
EXPO_ACCESS_TOKEN=

# --- Picture uploads (Cloudinary) ---
# From your Cloudinary dashboard → "API environment variable". Used for listing photos.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Receipts, agreements and chat attachments are uploaded as private (authenticated) Cloudinary files and only
# shared through 5-minute signed links.

# --- Marketplace bank transfers ---
SHEGERPAY_API_KEY=                        # sk_live_… from ShegerPay (receipt verification)
SHEGERPAY_BASE_URL=https://api.shegerpay.com
RECEIPT_VERIFIER=shegerpay                # "fake" for local development only
SHEGERPAY_RECEIVER_CHECK=strict           # strict: no receiver account from ShegerPay → manual Nebret review
SUPPORT_PHONE=+251 9xx xxx xxx            # the ONLY phone number shown in the app ("Call Nebret support")
FIRST_RECEIPT_HOLD_HOURS=24
BANK_HOLD_BUSINESS_DAYS=3
PARTNER_CONFIRM_SLA_BUSINESS_DAYS=2
DUAL_CONTROL_THRESHOLD=5000000            # ETB – above it two different owners/managers confirm
TRANSFER_TIME_TOLERANCE_MINUTES=30
BANK_ACCOUNT_COOLING_OFF_HOURS=24
RECEIPT_MAX_MB=10
VERIFIER_ESCALATE_HOURS=6
REFUND_DEADLINE_DAYS=14
NEBRET_HOLIDAYS=                          # comma list of YYYY-MM-DD; empty = built-in 2026–2027 list
MARKET_OFFICE_PAYMENTS=false              # true only to finish old office-paid orders
# Nebret's own listings (no partner company) are paid into this account:
HOUSE_BANK=CBE
HOUSE_ACCOUNT_NAME=
HOUSE_ACCOUNT_NUMBER=
AGREEMENT_TITLE=Sales & Installment Pre-Agreement
CHAT_VIOLATIONS_ALERT=3
CHAT_POLL_SECONDS=4
