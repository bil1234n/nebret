{
  "version": 2,
  "builds": [
    {
      "src": "nebret/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11",
        "buildCommand": "python manage.py migrate --noinput && python manage.py collectstatic --noinput"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "nebret/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/tick/",
      "schedule": "0 4 * * *"
    }
  ]
}
